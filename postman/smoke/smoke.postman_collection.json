    {
      "name": "crear_libro",
      "event": [
        { "listen": "test", "script": { "exec": [
          "pm.test('status 201', () => pm.response.to.have.status(201));",
          "pm.test('trae Location', () => pm.response.headers.has('Location'));",
          "const body = pm.response.json();",
          "pm.environment.set('lastBookId', body.id);"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Cien anios de soledad\",\n  \"author\": \"Gabriel Garcia Marquez\",\n  \"year\": 1967,\n  \"copies\": 3\n}" },
        "url": { "raw": "http://127.0.0.1:8000/books", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["books"] }
      },
      "response": []
    },
    {
      "name": "book/id",
      "event": [
        { "listen": "test", "script": { "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('el id coincide', () => {",
          "  const body = pm.response.json();",
          "  pm.expect(String(body.id)).to.eql(String(pm.environment.get('lastBookId')));",
          "});"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://127.0.0.1:8000/books/{{lastBookId}}", "protocol": "http", "host": ["127","0","0","1"], "port": "8000", "path": ["books", "{{lastBookId}}"] }
      },
      "response": []
