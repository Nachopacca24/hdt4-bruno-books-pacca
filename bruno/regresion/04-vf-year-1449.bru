meta {
  name: 04 VF year 1449
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Refactoring",
    "author": "Martin Fowler",
    "year": 1449,
    "copies": 2
  }
}

assert {
  res.status: eq 422
}

docs {
  Tecnica: Valores frontera (justo debajo del minimo)
  Valor probado: year = 1449
  Resultado esperado: 422 Unprocessable Entity
}
