}

body:json {
  {
    "title": "Refactoring",
    "author": "Martin Fowler",
    "year": 1999,
    "copies": 1000
  }
}

assert {
  res.status: eq 422
}

docs {
  Tecnica: Valores frontera (justo arriba del maximo 999)
  Valor probado: copies = 1000
  Resultado esperado: 422 Unprocessable Entity
}
